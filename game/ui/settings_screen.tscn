[ext_resource type="AudioStream" path="res://audio/ui/click.ogg" id="3_click"]

[node name="SettingsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
